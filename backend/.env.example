# Backend configuration (copy to backend/.env)

# --- Database ---
# With Docker stack (docker compose up -d):
DATABASE_URL=postgresql+psycopg://automl:automl@localhost:5432/automl
# Dev profile without Docker:
# DATABASE_URL=sqlite:///./automl.db

# --- Redis / Celery ---
# With Docker stack:
REDIS_URL=redis://localhost:6379/0
JOB_BACKEND=celery
# Dev profile without Docker (jobs run in-process):
# JOB_BACKEND=eager

# --- Object storage ---
# With Docker stack (MinIO):
USE_S3_STORAGE=true
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=automl
S3_SECRET_KEY=automl-dev-secret
S3_BUCKET=automl-datasets
# Dev profile without Docker (local filesystem storage):
# USE_S3_STORAGE=false

# --- Limits ---
MAX_DATASET_DOWNLOAD_BYTES=536870912
HTTP_TIMEOUT_SECONDS=20
AUDIT_CACHE_TTL_SECONDS=3600
